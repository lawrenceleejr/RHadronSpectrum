# Apptainer image for the RHadronSpectrum project: QUDA (develop) + PyQUDA + CuPy + analysis stack.
# Build on the AP:   apptainer build rhadron.sif env/apptainer.def
# QUDA is compiled for every compute capability >= 7.0 present in the OSPool (real SASS) plus
# compute_90 PTX for newer parts. CUDA 12.4 so the image runs with every OSPool driver (>= 12.4).
Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

%files
    env/build_quda.sh /opt/build/build_quda.sh
    env/build_pyquda.sh /opt/build/build_pyquda.sh

%environment
    export QUDA_PATH=/opt/quda
    export LD_LIBRARY_PATH=/opt/quda/lib:$LD_LIBRARY_PATH
    export OMPI_MCA_btl=self,vader
    export OMPI_MCA_pml=ob1
    export OMPI_ALLOW_RUN_AS_ROOT=1
    export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
    export PYTHONNOUSERSITE=1

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends git ninja-build python3 python3-dev python3-pip \
        libopenmpi-dev openmpi-bin libhdf5-dev pkg-config ca-certificates wget
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel cython "cmake>=3.28"
    python3 -m pip install --no-cache-dir "numpy<2.1" scipy h5py mpi4py cupy-cuda12x matplotlib \
        pyyaml gvar pyerrors pytest
    bash /opt/build/build_quda.sh
    bash /opt/build/build_pyquda.sh

%test
    python3 -c "import numpy, cupy, h5py, gvar, pyerrors; print('python stack ok')"
    python3 -c "import pyquda; print('pyquda', pyquda.__version__)"

%labels
    project RHadronSpectrum
